# Конфигурация Netmon для локального тестирования
# Запуск на 127.0.0.1 или 0.0.0.0 для проверки перед переносом

RADMON_HOST=0.0.0.0          # Слушать все интерфейсы (0.0.0.0) или только локальный (127.0.0.1)
RADMON_PORT=5000            # Порт приложения
SUBNET=192.168.1.0/24      # Мониторируемая подсеть (такая же как в сети)
SCAN_INTERVAL=300           # Интервал сканирования в секундах (5 минут)
MAX_WORKERS=64             # Меньше потоков для локального тестирования
PING_TIMEOUT=2             # Таймаут ping в секундах
LOG_LEVEL=DEBUG            # Подробные логи для отладки

# Примечание: Для тестирования на той же машине можно использовать:
# RADMON_HOST=127.0.0.1    # Только локальный доступ
# RADMON_HOST=0.0.0.0      # Доступ со всех сетевых интерфейсов